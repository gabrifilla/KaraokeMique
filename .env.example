# Copie para .env. Credenciais locais abaixo são apenas para banco de desenvolvimento.
# Instalação no servidor: use .env.server.example e INSTALAR.md.
DATABASE_URL=postgres://karaoke:karaoke@127.0.0.1:54329/karaoke_dev
WEB_ORIGIN=http://localhost:5173
PORT=3001
# pnpm dev assume NODE_ENV=development se ausente (aceita código livre de palco com sala explícita).
# Produção: definir NODE_ENV=production no ambiente; o pareamento exige o código autorizado.
YOUTUBE_API_KEY=
VITE_GIPHY_API_KEY=
# real = fornecedores reais; demo = catálogo e player artificiais, identificados na UI
INTEGRATION_MODE=real
