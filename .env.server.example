# Configuração para um servidor dentro da rede da casa. Copie para .env.server.
# Troque 192.168.1.100 pelo IPv4 fixo/reservado do servidor. Mantenha a porta igual a APP_PORT.
WEB_ORIGIN=http://karaoke.192.168.1.100.sslip.io:8080
APP_PORT=8080
LISTEN_ADDRESS=0.0.0.0
# Exceção explícita para rede privada. Pareamento de produção continua validando os códigos.
# Para acesso HTTPS por proxy, use WEB_ORIGIN=https://seu-dominio e false.
ALLOW_HTTP_LAN=true
# Só atrás de proxy/túnel (Cloudflare, nginx): endereço dele, ex. loopback ou 172.18.0.0/16.
# Vazio = usa o IP da conexão. Nunca use "true": qualquer cliente forjaria o próprio IP.
TRUST_PROXY=
# Crie uma senha longa usando somente letras e números (evita problemas de URL).
POSTGRES_PASSWORD=
# Reutilize suas chaves; não inclua este arquivo no pacote ou em repositórios.
YOUTUBE_API_KEY=
# Chave web do GIPHY: integra o bundle por desenho. Alterar exige reconstruir a imagem.
VITE_GIPHY_API_KEY=
# Abaixo: também permite execução compilada sem Docker (com PostgreSQL próprio).
NODE_ENV=production
SERVE_WEB=true
PORT=8080
INTEGRATION_MODE=real
# Só utilizado sem Docker. No Compose, a URL é montada automaticamente para o container database.
DATABASE_URL=postgresql://karaoke:SENHA_DO_BANCO@127.0.0.1:5432/karaoke
