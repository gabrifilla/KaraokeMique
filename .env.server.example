# Configuração do servidor do Karaoke Míque.
# O INICIAR cria o .env.server a partir deste arquivo. Preencha o .env.server, nunca este modelo,
# e não compartilhe nem suba o .env.server para o Git: ele guarda suas chaves e a senha do banco.

# ---------------------------------------------------------------------------
# 1. Como as pessoas vão acessar
# ---------------------------------------------------------------------------
# internet: qualquer pessoa abre https://seu-endereco, de qualquer rede (precisa da Cloudflare, veja INSTALAR.md).
# casa:     só quem está no Wi-Fi do servidor.
ACCESS_MODE=internet

# O endereço que todo mundo vai abrir, sem barra no final.
#   internet: o nome que você criou no túnel da Cloudflare, ex. https://karaoke.meudominio.com.br
#   casa:     http://karaoke.IP-DO-SERVIDOR.sslip.io:8080 (troque pelo IP, ex. 192.168.1.100)
WEB_ORIGIN=https://karaoke.seudominio.com.br

# Só no modo internet: o token do túnel, copiado do painel da Cloudflare.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# 2. Chaves das integrações
# ---------------------------------------------------------------------------
# YouTube Data API v3. Sem ela a busca de músicas não funciona.
YOUTUBE_API_KEY=
# GIPHY. Sem ela só os emojis funcionam. Se trocar depois, rode o INICIAR de novo para reconstruir.
VITE_GIPHY_API_KEY=
# Avisos no celular (push): "é sua vez", "você é o próximo", "hora de votar", mesmo com a tela
# bloqueada. Sem elas o resto funciona; só os avisos com tela bloqueada ficam desligados.
# Gere uma vez com: npx web-push generate-vapid-keys   (e não troque depois, senão os
# celulares inscritos param de receber até ligarem os avisos de novo).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do responsável pelo servidor (exigido pelos serviços de push), ex. mailto:voce@exemplo.com
VAPID_SUBJECT=

# ---------------------------------------------------------------------------
# 3. Banco de dados
# ---------------------------------------------------------------------------
# Deixe vazio: o INICIAR gera uma senha forte na primeira vez e grava aqui.
# Depois que o banco foi criado, não troque mais esta senha.
POSTGRES_PASSWORD=

# Porta no servidor. No modo casa, é a porta que vai no WEB_ORIGIN.
# No modo internet ela só aceita conexões do próprio servidor; quem está de fora entra pelo túnel.
APP_PORT=8080

# ---------------------------------------------------------------------------
# 4. Só para rodar sem Docker (pnpm build + pnpm start, com PostgreSQL próprio)
# ---------------------------------------------------------------------------
# Com Docker, o INICIAR ajusta estes valores sozinho conforme o ACCESS_MODE.
NODE_ENV=production
SERVE_WEB=true
PORT=8080
INTEGRATION_MODE=real
DATABASE_URL=postgresql://karaoke:SENHA_DO_BANCO@127.0.0.1:5432/karaoke
LISTEN_ADDRESS=0.0.0.0
# true só para HTTP na rede de casa. Com HTTPS (internet), false.
ALLOW_HTTP_LAN=false
# Atrás de proxy ou túnel: endereço dele (ex. loopback). Vazio = usa o IP da conexão.
# Nunca use "true": qualquer pessoa poderia fingir outro IP.
TRUST_PROXY=
