{
  "name": "karaoke",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch apps/api/src/dev.ts",
    "dev:web": "vite --config vite.config.ts --host 0.0.0.0 apps/web",
    "build": "node scripts/build.mjs",
    "start": "node --env-file=.env.server dist/server/apps/api/src/main.js",
    "release": "node scripts/package-server.mjs",
    "test:server": "node scripts/server-smoke.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "spike": "tsx scripts/spike.ts",
    "db:local": "tsx scripts/database.ts",
    "format:check": "prettier --check apps packages scripts tests *.ts *.json pnpm-workspace.yaml infra .github",
    "start:api": "tsx apps/api/src/main.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/nunito-sans": "5.3.0",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/platform-socket.io": "12.4.0",
    "@nestjs/websockets": "12.4.0",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@tanstack/react-query": "5.107.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.7",
    "embedded-postgres": "18.6.0-beta.19",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
